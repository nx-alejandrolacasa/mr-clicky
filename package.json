{
  "name": "mr-clicky-monorepo",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev:firefox": "npm run dev -w @mr-clicky/firefox",
    "dev:chrome": "npm run dev -w @mr-clicky/chrome",
    "build": "npm run build -w @mr-clicky/firefox && npm run build -w @mr-clicky/chrome",
    "build:firefox": "npm run build -w @mr-clicky/firefox",
    "build:chrome": "npm run build -w @mr-clicky/chrome",
    "lint": "npm run lint --workspaces --if-present",
    "test": "node scripts/test-rules.mjs",
    "typecheck": "tsc -b"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.280",
    "@types/node": "^22.0.0",
    "esbuild": "^0.24.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
